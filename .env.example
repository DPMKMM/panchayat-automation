# ==============================================================================
# e-Panchayat Automation - Environment Configuration Template (.env.example)
# Duplicate this file to .env and configure values before starting the application
# ==============================================================================

# Application Environment ("development" or "production")
ENVIRONMENT=production
PORT=8050
HOST=127.0.0.1
LOG_LEVEL=INFO

# OpenAPI & Swagger Documentation (Disable in production to prevent schema enumeration)
ENABLE_DOCS=false

# Session & Cookie Security (Generate a strong 64-character hex secret: `openssl rand -hex 32`)
WEB_SESSION_SECRET=replace_with_a_secure_random_64_character_hex_secret

# Runtime Storage & Retention Policies
DATA_DIR=./data
MAX_UPLOAD_BYTES=31457280
TEMP_RETENTION_HOURS=24

# Firebase Authentication & Cloud Firestore (Client Web SDK Configuration)
FIREBASE_PROJECT_ID=epanchayat-automation-tg
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_AUTH_DOMAIN=epanchayat-automation-tg.firebaseapp.com
FIREBASE_STORAGE_BUCKET=epanchayat-automation-tg.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
FIREBASE_APP_ID=your_firebase_web_app_id_here
FIREBASE_DATABASE_ID=(default)

# Firebase Admin SDK Service Account (Path to JSON file OR raw Base64/JSON string)
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Administrator Privileges (Comma-separated administrator Google email addresses)
ADMIN_EMAILS=admin@example.com

# Optional Live DCB Proxy (if using reverse proxy for live epanchayat data)
DCB_PORTAL_PROXY_URL=
DCB_PORTAL_PROXY_TOKEN=

# Cloudflare Tunnel & Domain Configuration
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
CUSTOM_DOMAIN=panchayatautomation.in
