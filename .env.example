# Secret used to sign short-lived browser report-session cookies (minimum 32 characters).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
WEB_SESSION_SECRET=replace-with-a-long-random-secret

# Required for any public cloud deployment. Share the password only with intended users.
PUBLIC_ACCESS_REQUIRED=true
PUBLIC_ACCESS_PASSWORD=replace-with-a-shared-passcode-at-least-14-characters
PUBLIC_ACCESS_SIGNING_KEY=replace-with-a-random-secret-at-least-32-characters

# Each browser gets an isolated portal session; portal automation jobs use one worker queue.
MAX_ACTIVE_PORTAL_SESSIONS=3

# SQLite report/session database and generated PDFs live under this directory.
# Keep DATA_DIR on persistent storage when deploying to a cloud VM.
DATA_DIR=./data
MAX_UPLOAD_BYTES=31457280
LOG_LEVEL=INFO

# Optional e-Panchayat regional Worker proxy for cloud DCB requests.
# Leave blank to fetch directly from the live portal during local development.
DCB_PORTAL_PROXY_URL=
DCB_PORTAL_PROXY_TOKEN=
