# Application Environment ("development" or "production")
ENVIRONMENT=development
PORT=8050
HOST=127.0.0.1
LOG_LEVEL=INFO

# Session & Cookie Security (SET A STRONG RANDOM SECRET IN PRODUCTION)
WEB_SESSION_SECRET=replace-with-a-long-random-secret

# Runtime Storage & Retention Policies
DATA_DIR=./data
MAX_UPLOAD_BYTES=31457280
TEMP_RETENTION_HOURS=24

# Firebase Authentication & Cloud Firestore Configuration
FIREBASE_PROJECT_ID=epanchayat-automation-tg
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=epanchayat-automation-tg.firebaseapp.com
FIREBASE_STORAGE_BUCKET=epanchayat-automation-tg.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_DATABASE_ID=(default)
# Path to Firebase Admin SDK service account JSON (or raw JSON in FIREBASE_SERVICE_ACCOUNT_JSON)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Comma-separated administrator Google email addresses (receive Admin Dashboard privileges)
ADMIN_EMAILS=

# Development Fallbacks (automatically disabled when ENVIRONMENT=production)
ALLOW_CLOUD_SYNC_FALLBACK=true

# Optional Live DCB Proxy (if using reverse proxy for live epanchayat data)
DCB_PORTAL_PROXY_URL=
DCB_PORTAL_PROXY_TOKEN=

# Cloudflare Tunnel & Domain Configuration
CLOUDFLARE_TUNNEL_TOKEN=
CUSTOM_DOMAIN=panchayatautomation.in
